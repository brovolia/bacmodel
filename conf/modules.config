/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'PROKKA' {
        publishDir = [
            path: { "${params.outdir}/annotation/prokka" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BAKTA_BAKTA' {
        ext.args = { "--min-contig-length ${params.min_contig_length}" }
        publishDir = [
            path: { "${params.outdir}/annotation/bakta" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BAKTA_BAKTADBDOWNLOAD' {
        ext.args = { "${params.baktadb_download_args}" }
        publishDir = [
            path: { "${params.outdir}/bakta/db" },
            mode: params.publish_dir_mode,
            enabled: false  // Don't publish the huge database
        ]
    }

    withName: 'MACSYFINDER_SEARCH' {
        ext.args = '--db-type unordered'
        publishDir = [
            path: { "${params.outdir}/functional_annotation/macsyfinder" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MACSYFINDER_DOWNLOAD' {
        publishDir = [
            path: { "${params.outdir}/macsyfinder/models" },
            mode: params.publish_dir_mode,
            enabled: false  // Don't publish the models
        ]
    }

    withName: 'TRAITAR' {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/phenotype/traitar" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'TRAITAR_PFAMGET' {
        publishDir = [
            path: { "${params.outdir}/traitar/pfam" },
            mode: params.publish_dir_mode,
            enabled: false  // Don't publish the large database
        ]
    }

    withName: 'CARVEME_CARVE' {
        ext.args = { meta.medium_carveme ? "--gapfill ${meta.medium_carveme}" : '--gapfill complete' }
        publishDir = [
            path: { "${params.outdir}/metabolic_models/carveme" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GAPSEQ_DOALL' {
        ext.args = { 
            def base_args = '-b 200 -A diamond'
            // If medium_gapseq is provided and is not a file path, it's a medium name
            if (meta.medium_gapseq && !meta.medium_gapseq.toString().contains('/')) {
                return "${base_args} -m ${meta.medium_gapseq}"
            }
            return base_args
        }
        containerOptions = { workflow.containerEngine == 'singularity' ? '--home $PWD' : '-e HOME=$PWD' }
        publishDir = [
            path: { "${params.outdir}/metabolic_models/gapseq" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MEMOTE_RUN' {
        ext.prefix = { "${meta.id}_${meta.tool ?: 'model'}" }
        publishDir = [
            path: { "${params.outdir}/metabolic_models/memote" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MEMOTE_REPORT' {
        ext.prefix = { "${meta.id}_${meta.tool ?: 'model'}" }
        publishDir = [
            path: { "${params.outdir}/metabolic_models/memote" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BACMODEL_SUMMARY' {
        containerOptions = { workflow.containerEngine == 'singularity' ? '--home $PWD' : '-e HOME=$PWD' }
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}

