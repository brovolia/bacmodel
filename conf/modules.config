/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode
    ]

    withName: 'PROKKA' {
        publishDir = [
            path: { "${params.outdir}/annotation/prokka" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'BAKTA_BAKTA' {
        ext.args = { "--min-contig-length ${params.min_contig_length}" }
        publishDir = [
            path: { "${params.outdir}/annotation/bakta" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'BAKTA_BAKTADBDOWNLOAD' {
        ext.args = { "--type ${params.baktadb_type}" }
        // Only invoked when the DB isn't already cached at params.baktadb (see the
        // subworkflow's existence check) - publish the result there for next time.
        publishDir = [
            path: { "${params.baktadb}" },
            mode: 'copy'
        ]
    }

    withName: 'MACSYFINDER_SEARCH' {
        ext.args = { "--db-type ${params.macsyfinder_db_type}" }
        publishDir = [
            path: { "${params.outdir}/macromolecular_systems/macsyfinder" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MACSYFINDER_DOWNLOAD' {
        // Only invoked when these models aren't already cached at
        // params.macsyfinder_db/<model_name> (see the subworkflow's existence check) -
        // publish the result there for next time.
        publishDir = [
            path: { "${params.macsyfinder_db}/${model_name}" },
            mode: 'copy'
        ]
    }

    withName: 'TRAITAR' {
        publishDir = [
            path: { "${params.outdir}/phenotype/traitar" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'TRAITAR_PFAMGET' {
        // Only invoked when the DB isn't already cached at params.pfamdb (see the
        // subworkflow's existence check) - publish the result there for next time.
        publishDir = [
            path: { "${params.pfamdb}" },
            mode: 'copy'
        ]
    }

    withName: 'CARVEME_CARVE' {
        ext.args = { meta.medium_carveme ? "--gapfill ${meta.medium_carveme}" : '' }
        publishDir = [
            path: { "${params.outdir}/metabolic_models/carveme" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GAPSEQ_DOALL' {
        ext.args = {
            def base_args = params.gapseq_doall_args ?: '-b 200 -A diamond'
            // medium_gapseq is a built-in medium name (e.g. 'LB', 'M9'); a custom
            // medium CSV is provided via medium_gapseq_csv instead (passed as a
            // file input to the module, not via ext.args - see GAPSEQ_DOALL's
            // own medium_arg handling in modules/nf-core/gapseq/doall/main.nf)
            if (meta.medium_gapseq) {
                return "${base_args} -m ${meta.medium_gapseq}"
            }
            return base_args
        }
        containerOptions = { workflow.containerEngine == 'singularity' ? '--home $PWD' : '-e HOME=$PWD' }
        publishDir = [
            path: { "${params.outdir}/metabolic_models/gapseq" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GAPSEQ_REQUESTDB' {
        publishDir = [
            enabled: false  // Don't publish database - it's shared across all samples
        ]
    }

    withName: 'GAPSEQ_FIND' {
        ext.args = { params.gapseq_find_args ?: '-b 200 -A diamond' }
        containerOptions = { workflow.containerEngine == 'singularity' ? '--home $PWD' : '-e HOME=$PWD' }
        publishDir = [
            path: { "${params.outdir}/metabolic_models/gapseq/intermediate/find" },
            mode: params.publish_dir_mode,
            pattern: '*-Pathways.tbl',
            enabled: params.gapseq_find_args || params.gapseq_findtransport_args || params.gapseq_draft_args || params.gapseq_medium_args || params.gapseq_fill_args
        ]
    }

    withName: 'GAPSEQ_FINDTRANSPORT' {
        ext.args = { params.gapseq_findtransport_args ?: '-b 200' }
        containerOptions = { workflow.containerEngine == 'singularity' ? '--home $PWD' : '-e HOME=$PWD' }
        publishDir = [
            path: { "${params.outdir}/metabolic_models/gapseq/intermediate/findtransport" },
            mode: params.publish_dir_mode,
            pattern: '*-Transporter.tbl',
            enabled: params.gapseq_find_args || params.gapseq_findtransport_args || params.gapseq_draft_args || params.gapseq_medium_args || params.gapseq_fill_args
        ]
    }

    withName: 'GAPSEQ_DRAFT' {
        ext.args = { params.gapseq_draft_args ?: '' }
        containerOptions = { workflow.containerEngine == 'singularity' ? '--home $PWD' : '-e HOME=$PWD' }
        publishDir = [
            path: { "${params.outdir}/metabolic_models/gapseq/intermediate/draft" },
            mode: params.publish_dir_mode,
            pattern: '*-draft.RDS',
            enabled: params.gapseq_find_args || params.gapseq_findtransport_args || params.gapseq_draft_args || params.gapseq_medium_args || params.gapseq_fill_args
        ]
    }

    withName: 'GAPSEQ_MEDIUM' {
        ext.args = { params.gapseq_medium_args ?: '' }
        containerOptions = { workflow.containerEngine == 'singularity' ? '--home $PWD' : '-e HOME=$PWD' }
        publishDir = [
            path: { "${params.outdir}/metabolic_models/gapseq/intermediate/medium" },
            mode: params.publish_dir_mode,
            pattern: '*.csv',
            enabled: params.gapseq_find_args || params.gapseq_findtransport_args || params.gapseq_draft_args || params.gapseq_medium_args || params.gapseq_fill_args
        ]
    }

    withName: 'GAPSEQ_FILL' {
        ext.args = { params.gapseq_fill_args ?: '' }
        containerOptions = { workflow.containerEngine == 'singularity' ? '--home $PWD' : '-e HOME=$PWD' }
        publishDir = [
            path: { "${params.outdir}/metabolic_models/gapseq" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MEMOTE_RUN' {
        ext.prefix = { "${meta.id}_${meta.tool ?: 'model'}" }
        publishDir = [
            path: { "${params.outdir}/metabolic_models/memote" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MEMOTE_REPORT' {
        ext.prefix = { "${meta.id}_${meta.tool ?: 'model'}" }
        publishDir = [
            path: { "${params.outdir}/metabolic_models/memote" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'BACMODEL_SUMMARY' {
        containerOptions = { workflow.containerEngine == 'singularity' ? '--home $PWD' : '-e HOME=$PWD' }
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'RENAME_GAPSEQ_XML' {
        publishDir = [
            enabled: false  // Don't publish renamed XML files - they're intermediate files for the summary
        ]
    }

}
