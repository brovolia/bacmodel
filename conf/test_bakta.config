/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running Bakta annotation tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple test
    of the Bakta annotation path.

    Use as follows:
        nextflow run nf-core/bacmodel -profile test_bakta,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Bakta test profile'
    config_profile_description = 'Minimal test dataset to check the Bakta annotation path'

    // Input data - small bacterial genome test dataset
    input               = params.pipelines_testdata_base_path + 'bacmodel/samplesheet.tsv'

    // Test with Bakta annotation
    annotation_tool     = 'bakta'
    skip_macsyfinder    = true  // Skip for faster testing
    skip_traitar        = true  // Skip for faster testing
    skip_carveme        = true  // Skip for faster testing
}
