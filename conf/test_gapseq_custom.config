/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running Gapseq custom-subworkflow tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple test
    of Gapseq's custom subworkflow mode (find -> findtransport -> draft ->
    medium -> fill), triggered by setting any gapseq_*_args parameter.

    Use as follows:
        nextflow run nf-core/bacmodel -profile test_gapseq_custom,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Gapseq custom workflow test profile'
    config_profile_description = 'Minimal test dataset to check Gapseq custom subworkflow parameters'

    // Input data - small bacterial genome test dataset
    input               = params.pipelines_testdata_base_path + 'bacmodel/samplesheet.tsv'

    // Test Gapseq custom workflow mode with individual subworkflow parameters
    annotation_tool     = 'prokka'
    skip_macsyfinder    = true  // Skip for faster testing
    skip_traitar        = true  // Skip for faster testing
    skip_carveme        = true  // Skip for faster testing
    skip_gapseq         = false
    skip_memote         = false

    // Custom parameters trigger custom workflow mode
    // This tests find -> findtransport -> draft -> medium -> fill sequence
    gapseq_find_args          = '-b 150 -A diamond'
    gapseq_findtransport_args = '-b 150'
    gapseq_fill_args          = '-b 50'
}
