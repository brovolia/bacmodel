/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running multi-sample tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run the pipeline on more
    than one sample. Every other test profile uses a single-genome
    samplesheet, which can't exercise pipeline code that only breaks with
    multiple samples (e.g. issue #38, the macsyfinder/traitar name collision
    in BACMODEL_SUMMARY that only shows up once more than one sample reaches
    that process).

    Use as follows:
        nextflow run nf-core/bacmodel -profile test_multisample,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '2.h'
    ]
}

params {
    config_profile_name        = 'Multi-sample test profile'
    config_profile_description = 'Three-genome test dataset to check multi-sample pipeline function'

    // Input data - three genomes spanning distinct genera/phyla, so results
    // collected across samples are also a meaningful (if small) community
    input               = params.pipelines_testdata_base_path + 'bacmodel/samplesheet_multisample.tsv'

    // Enable the tools whose summary inputs were affected by issue #38.
    // Gapseq/Memote are left skipped to keep runtime down - their summary
    // inputs already had the equivalent fix (stageAs) applied earlier and
    // aren't part of what this profile needs to re-check.
    annotation_tool     = 'prokka'
    skip_macsyfinder    = false
    skip_traitar        = false
    skip_carveme        = false
    skip_gapseq         = true
    skip_memote         = true
    macsyfinder_models  = 'TXSS'
}
